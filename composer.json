{
    "name": "componenta/auth-app",
    "description": "Authentication context integration for Componenta DI",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5.13",
        "componenta/auth": "^4.0.0",
        "componenta/config": "^4.0.0",
        "componenta/di": "^6.0.0",
        "componenta/identity": "^1.1.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Auth\\App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Auth\\App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Auth\\App\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-auth-3": "2.0.x-dev",
            "dev-fix/auth-dependency-audit-2026-11-27": "3.0.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=max",
        "check": [
            "@phpstan",
            "@test"
        ]
    }
}
